# ─── Altraware Technologies — environment variables ─────────────────────────
# Copy to .env.local and fill in. Anything left blank degrades gracefully:
# the site still runs, but the matching feature is disabled.
# .env* files are git-ignored — never commit real keys.

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical origin, used for sitemap, robots.txt and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://altraware-tech.vercel.app

# ── Admin access ────────────────────────────────────────────────────────────
# Comma-separated Gmail addresses allowed to sign in with Google.
ADMIN_EMAILS=david@example.com,clemence@example.com
# Passcode alternative to Google login. Make it long and random.
ADMIN_MASTER_KEY=
# Signs the admin session cookie. Falls back to ADMIN_MASTER_KEY if unset,
# but set a dedicated random value in production: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ── Firebase (Google sign-in) ───────────────────────────────────────────────
# From Firebase Console → Project settings → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side key for verifying ID tokens (accounts:lookup). Falls back to
# NEXT_PUBLIC_FIREBASE_API_KEY when blank.
FIREBASE_API_KEY=

# ── Email (project inquiries) ───────────────────────────────────────────────
# If SMTP is unset, the inquiry form returns an error and tells the visitor to
# WhatsApp instead — it never pretends to have sent a message.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# For Gmail, use an App Password (16 characters), not your account password.
SMTP_PASS=
SMTP_FROM="Altraware Technology" <hello@example.com>
ADMIN_NOTIFICATION_EMAIL=

# ── AI assistant ("Altra") ──────────────────────────────────────────────────
# Keys are tried in random order; comma-separate several for rotation.
INCEPTION_API_KEYS=
INCEPTION_MODEL=mercury-2.5
INCEPTION_REASONING_EFFORT=low

# Fallback provider, used when every Inception key fails.
AGNES_API_KEYS=
AGNES_MODEL=openai/deepseek-ai/DeepSeek-V3

# ── Cloudinary (optional) ───────────────────────────────────────────────────
# Only needed if you upload images from the browser via an unsigned preset.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
