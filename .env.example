# ─── Copy to .env.local (NEVER commit real secrets) ───
# Restart `npm run dev` after changing any variable.

# ─── AI ENGINES (server-side only — never NEXT_PUBLIC_) ───
# Used by /api/chat (Altra assistant). Either provider works; both = fallback.
INCEPTION_API_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-2.5
INCEPTION_REASONING_EFFORT=low
INCEPTION_API_KEY=
INCEPTION_API_KEYS=
AGNES_API_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=openai/deepseek-ai/DeepSeek-V3
AGNES_API_KEY=
AGNES_API_KEYS=

# ─── NODEMAILER / SMTP (server-side only — client auto-reply + admin alert) ───
# For Gmail: 16-digit App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=altrawaretechnology@gmail.com
SMTP_PASS=
SMTP_FROM="Altraware Technology" <altrawaretechnology@gmail.com>
ADMIN_NOTIFICATION_EMAIL=altrawaretechnology@gmail.com

# ─── CLOUDINARY (unsigned upload — public values, not secret) ───
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Server-side only, never in client code:
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ─── ADMIN CONSOLE (server-side only — NEVER NEXT_PUBLIC_) ───
# Passphrase for /admin — long and secret.
ADMIN_MASTER_KEY=
